# Cloudflare Pages headers.
#
# The build is content-hashed, so the JS, CSS and workers can be cached
# permanently. The assets under /assets are *not* hashed — they are produced by
# tools/process-assets.mjs and referenced by stable name — so they get a long
# cache with revalidation instead, which is the honest thing for a 54MB model
# directory that changes only when the pipeline is re-run.

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/assets/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: model/gltf-binary

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # The game is entirely local: no network calls, no analytics, no third-party
  # anything. Saying so in a header means a broken build fails loudly rather
  # than quietly phoning somewhere.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'
